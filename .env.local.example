# Example environment configuration for local development
# Copy this file to .env.local and adjust values as needed

# Backend API URL - change this to your local backend instance
# For local .NET backend typically running on port 5000 or 5001
# BASE_URI=http://localhost:5000
# BASE_URI=https://localhost:5001

# Or use the dev environment
# BASE_URI=https://dev.imperaonline.de

# Default (if not set) is production:
# BASE_URI=https://www.imperaonline.de
